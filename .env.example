# Banco de dados (PostgreSQL) — precisa ser online e persistente
DATABASE_URL="postgresql://user:password@host:5432/lamia_dolce_vita?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="gerar-com: openssl rand -base64 32"

# Conta do Diretor/Administrador (seção 43 da especificação)
# NUNCA commitar a senha real. Isso é usado apenas pelo script de seed
# para criar a conta inicial da Lamia. Depois do primeiro login, oriente
# a troca de senha.
ADMIN_USERNAME="Lamia"
ADMIN_INITIAL_PASSWORD="defina-uma-senha-forte-aqui"

# Nome da loja (usado em textos da interface)
STORE_NAME="La Mia Dolce Vita"
